generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
  agent
  superadmin
}
enum UserStatus {
  pending
  approved
  blocked
}
enum BookingStatus {
  on_hold
  confirmed
  issued
  cancelled
  expired
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String @map("password_hash")
  agencyName    String?  @map("agency_name")
  phone         String?
  whatsapp      String?
  ownerName     String?  @map("owner_name")
  address       String?  @db.Text
  licenseNo     String?  @map("license_no")
  voucherStyle  String   @default("detailed") @map("voucher_style")
  role          UserRole @default(agent)
  status        UserStatus @default(pending)
  deliveryPref  String   @default("email") @map("delivery_pref")
  discount      Decimal  @default(0) @db.Decimal(12,2)
  umrahAccess   Boolean  @default(false) @map("umrah_access")
  canSeeProfit  Boolean  @default(false) @map("can_see_profit")
  permissions   Json?
  createdAt     DateTime @default(now()) @map("created_at")
  flights           Flight[]  @relation("FlightOwner")
  bookings          Booking[]
  confirmedBookings Booking[] @relation("ConfirmedBookings")
  payments          Payment[] @relation("AgentPayments")
  recorded          Payment[] @relation("RecordedPayments")
  @@map("profiles")
}

model Flight {
  id            String      @id @default(uuid())
  airline       String
  flightNo      String      @map("flight_no")
  origin        String
  destination   String
  departureAt   DateTime    @map("departure_at")
  arrivalAt     DateTime?   @map("arrival_at")
  price         Decimal     @db.Decimal(12,2)
  baggage       String?
  meal          String?
  totalSeats    Int         @map("total_seats")
  holdHours     Int         @default(6) @map("hold_hours")
  active        Boolean     @default(true)
  ownerId       String?     @map("owner_id")
  owner         User?       @relation("FlightOwner", fields: [ownerId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")
  bookings      Booking[]
  legs          FlightLeg[]
  private       FlightPrivate?
  @@map("flights")
}

model FlightPrivate {
  id      String @id @default(uuid()) @map("flight_id")
  flight  Flight @relation(fields: [id], references: [id], onDelete: Cascade)
  pnr     String?
  remarks String?
  @@map("flight_private")
}

model FlightLeg {
  id          String @id @default(uuid())
  flightId    String @map("flight_id")
  flight      Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  journey     Int @default(0)
  seq         Int @default(0)
  airline     String?
  flightNo    String? @map("flight_no")
  origin      String?
  destination String?
  departureAt DateTime? @map("departure_at")
  arrivalAt   DateTime? @map("arrival_at")
  @@map("flight_legs")
}

model Booking {
  id            String        @id @default(uuid())
  ref           String        @unique
  bookingNo     Int?          @map("booking_no")
  flightId      String        @map("flight_id")
  flight        Flight        @relation(fields: [flightId], references: [id])
  agentId       String        @map("agent_id")
  agent         User          @relation(fields: [agentId], references: [id])
  confirmedBy   String?       @map("confirmed_by")
  confirmer     User?         @relation("ConfirmedBookings", fields: [confirmedBy], references: [id])
  status        BookingStatus @default(on_hold)
  holdExpiresAt DateTime?     @map("hold_expires_at")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12,2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12,2)
  ticketPdfPath String?       @map("ticket_pdf_path")
  pnr           String?
  editUnlocked  Boolean       @default(false) @map("edit_unlocked")
  createdAt     DateTime      @default(now()) @map("created_at")
  passengers    Passenger[]
  payments      Payment[]
  @@map("bookings")
}

model Passenger {
  id             String @id @default(uuid())
  bookingId      String @map("booking_id")
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title          String? @default("")
  firstName      String @map("first_name")
  lastName       String @map("last_name")
  paxType        String @default("adult") @map("pax_type")
  dob            DateTime @db.Date
  passportNumber String @map("passport_number")
  passportExpiry DateTime @db.Date @map("passport_expiry")
  nationality    String
  @@map("passengers")
}

model Payment {
  id         String @id @default(uuid())
  bookingId  String @map("booking_id")
  booking    Booking @relation(fields: [bookingId], references: [id])
  agentId    String @map("agent_id")
  agent      User @relation("AgentPayments", fields: [agentId], references: [id])
  amount     Decimal @db.Decimal(12,2)
  method     String?
  note       String?
  recordedBy String? @map("recorded_by")
  recorder   User? @relation("RecordedPayments", fields: [recordedBy], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  @@map("payments")
}

model AuditLog {
  id        String @id @default(uuid())
  actor     String?
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("audit_log")
}

model BankAccount {
  id           String @id @default(uuid())
  bankName     String @map("bank_name")
  accountTitle String @map("account_title")
  accountNo    String @map("account_no")
  iban         String?
  branch       String?
  note         String?
  sort         Int @default(0)
  active       Boolean @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("bank_accounts")
}

model HoldRule {
  id         Int @id @default(1)
  openTime   String @map("open_time")
  closeTime  String @map("close_time")
  dayHoldMax Int @default(0) @map("day_hold_max")
  nearHoldMax Int @default(0) @map("near_hold_max")
  @@map("hold_rules")
}

model Supplier {
  id        String @id @default(uuid())
  name      String
  phone     String?
  note      String?
  active    Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("suppliers")
}


model FlightCost {
  id        String @id @default(uuid())
  flightId  String @map("flight_id")
  supplier  String?
  buyPrice  Decimal? @map("buy_price") @db.Decimal(12,2)
  @@unique([flightId])
  @@map("flight_cost")
}
